# PASH Gateway v2 — Environment Variables
# Copy to .env and fill in values

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://pash:pash@localhost:5432/pash_gateway

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=pash:

# ── LLM Providers (master keys — used when client has no BYOK) ────────────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── PASH Prompt Injection ──────────────────────────────────────────────────────
PASH_PROMPT_LANG=ru
PASH_PROMPT_MODE=pash
PASH_PROMPT_PLACEMENT=prefix

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_KEY_RPM=60
RATE_LIMIT_PER_IP_RPM=10

# ── Circuit Breaker ────────────────────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000
CB_PROVIDER_CHAIN=openrouter,openai,anthropic

# ── Streaming ──────────────────────────────────────────────────────────────────
UPSTREAM_TIMEOUT_MS=30000
MAX_LINES_PER_REQUEST=500
SNAPSHOT_INTERVAL=50

# ── Sessions ───────────────────────────────────────────────────────────────────
SNAPSHOT_TTL_MS=1800000

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
