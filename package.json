{
  "name": "pash-gateway",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build":        "npm run build --workspaces --if-present",
    "test":         "npm run test --workspaces --if-present",
    "test:protocol":"npm test --workspace=packages/protocol",
    "test:state":   "npm test --workspace=packages/state-engine",
    "test:gateway": "npm test --workspace=apps/gateway",
    "dev":          "npm run dev --workspace=apps/gateway",
    "migrate":      "node migrations/run.js",
    "docker:up":    "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down":  "docker-compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  }
}
